{
    "tasks": [
        {
            "type": "shell",
            "label": "CMake configure",
            "command": "cmake --preset debug",
            "windows": {
                "command": "cmake --preset mingw"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "CMake build",
            "command": "cmake --build --preset debug --target DND_PROJECT",
            "windows": {
                "command": "cmake --build --preset mingw --target DND_PROJECT"
            },
            "dependsOn": "CMake configure",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "CMake test",
            "command": "cmake --build --preset debug && ctest --preset debug",
            "windows": {
                "command": "cmake --build --preset mingw && ctest --preset mingw"
            },
            "dependsOn": "CMake configure",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "test"
        },
        {
            "label": "Run in Konsole",
            "type": "shell",
            "command": "konsole",
            "args": [
                "--hold",
                "--workdir",
                "${workspaceFolder}",
                "-e",
                "./build/DND_PROJECT"
            ],
            "windows": {
                "command": "cmd",
                "args": [
                    "/c",
                    "start",
                    "cmd",
                    "/k",
                    "${workspaceFolder}\\build\\DND_PROJECT.exe"
                ]
            },
            "dependsOn": "CMake build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}
